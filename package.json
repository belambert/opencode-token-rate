{
  "name": "opencode-token-rate",
  "version": "0.1.0",
  "description": "OpenCode v2 sidebar plugin showing tokens/sec and the current model's per-token prices.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belambert/opencode-token-rate.git"
  },
  "homepage": "https://github.com/belambert/opencode-token-rate#readme",
  "bugs": "https://github.com/belambert/opencode-token-rate/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "tokens-per-second",
    "pricing"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc --noEmit",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "2.2.6",
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  }
}
